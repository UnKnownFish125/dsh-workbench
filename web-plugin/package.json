{
  "name": "dsh-workbench",
  "version": "0.1.0",
  "description": "DeepSeek Harness 非线性工作台：结构树 + 统一会话管理器（节点挂会话，子节点继承上层上下文）",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./dsh.patch.yml": "./dsh.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "dsh.patch.yml",
    "package.json"
  ],
  "license": "AGPL-3.0-only",
  "peerDependencies": {
    "@deepseek-ai/dsh-settings": ">=0.1.0-rc.6 <0.2",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "dsh": {
    "category": "Workbench",
    "categories": ["Workbench"],
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./dsh.patch.yml"
    }
  }
}
